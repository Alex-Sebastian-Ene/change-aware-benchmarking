harness:
  lm_eval_repo: https://github.com/huggingface/lm-evaluation-harness
  lm_eval_sha: <40-char commit>
  vllm_version: <e.g. 0.6.3>
  dtype: bfloat16
  batch_size: 32
  apply_chat_template: false
  lockfile_sha256: <sha256 of uv.lock>
  apptainer_digest: <sha256 of the .sif>

